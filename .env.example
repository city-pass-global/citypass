NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Never place a secret/service-role key in NEXT_PUBLIC_* variables.
# Browser-safe Pollar key; testnet/mainnet is derived from its prefix.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Backend only. Never prefix these variables with NEXT_PUBLIC_.
POLLAR_SECRET_KEY=
# 32-byte hex application-session attestation key. Must match private.pollar_bridge_config.
POLLAR_SESSION_BRIDGE_KEY=
# Optional public activity mirror. Only testnet is supported.
STELLAR_ACTIVITY_NETWORK=testnet
STELLAR_ACTIVITY_CONTRACT_ID=
# Backend-only dedicated testnet issuer. Never use a treasury or traveler key.
STELLAR_ACTIVITY_ISSUER_SECRET=
# Stable 32-byte lowercase hex HMAC key for pseudonymous event IDs; back up with issuer keys.
STELLAR_ACTIVITY_HASH_KEY=

# Agent pass purchase API (testnet only; enable after applying x402 migration).
X402_ENABLED=0
# Optional OZ testnet facilitator key. If absent, use the public x402.org testnet facilitator.
X402_OZ_API_KEY=
# Dedicated agent CLI wallet and traveler-created purchase credential (never NEXT_PUBLIC_).
X402_AGENT_SECRET=
X402_PURCHASE_TOKEN=
X402_PURCHASE_URL=
